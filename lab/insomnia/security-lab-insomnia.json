        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": 1,
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"login\": \"alice\",\n  \"password\": \"alicepass\",\n  \"repeatedPassword\": \"alicepass\"\n}"
      },
      "description": "200 + token. 409 if the login is taken, 400 if the passwords do not match."
    },
    {
      "_id": "req_register_bob",
      "parentId": "wrk_security_lab",
