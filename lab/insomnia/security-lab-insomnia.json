        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": 3,
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"login\": \"alice\",\n  \"password\": \"alicepass\"\n}"
      },
      "description": "200 + token. 401 with wrong credentials."
    },
    {
      "_id": "req_login_bob",
      "parentId": "wrk_security_lab",
      "_type": "request",
      "name": "Login (bob)",
