        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": 2,
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"login\": \"bob\",\n  \"password\": \"bobpass\",\n  \"repeatedPassword\": \"bobpass\"\n}"
      },
      "description": "Second user to exchange messages with."
    },
    {
      "_id": "req_login_alice",
      "parentId": "wrk_security_lab",
      "_type": "request",
      "name": "Login (alice)",
