        {
          "name": "Authorization",
          "value": "Bearer {% response 'body', 'req_login_alice', '$.token', 'raw' %}"
        },
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "authentication": {},
      "metaSortKey": 5,
      "body": {},
      "description": "List of registered users. Run Login (alice) first: the token is taken from the last login response automatically."
    },
